rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /users/{userId}/addresses/{addressId} {
      function isOwner() {
        return request.auth != null &&
          request.auth.uid == userId &&
          addressId.matches('^[A-Za-z0-9_-]{1,128}$');
      }

      function hasValidAddress() {
        return request.resource.data.keys().hasOnly([
            "label",
            "fullName",
            "phone",
            "addressLine1",
            "addressLine2",
            "city",
            "state",
            "postalCode",
            "country",
            "isDefault",
            "updatedAt"
          ]) &&
          request.resource.data.keys().hasAll([
            "label",
            "addressLine1",
            "addressLine2",
            "city",
            "state",
            "postalCode",
            "country",
            "isDefault",
            "updatedAt"
          ]) &&
          request.resource.data.label is string &&
          request.resource.data.label.size() > 0 &&
          request.resource.data.label.size() <= 40 &&
          (!("fullName" in request.resource.data) ||
            (request.resource.data.fullName is string &&
              request.resource.data.fullName.size() > 0 &&
              request.resource.data.fullName.size() <= 100)) &&
          (!("phone" in request.resource.data) ||
            (request.resource.data.phone is string &&
              request.resource.data.phone.size() <= 20 &&
              request.resource.data.phone.matches('^[+0-9() -]{0,20}$'))) &&
          request.resource.data.addressLine1 is string &&
          request.resource.data.addressLine1.size() > 0 &&
          request.resource.data.addressLine1.size() <= 120 &&
          request.resource.data.addressLine2 is string &&
          request.resource.data.addressLine2.size() <= 120 &&
          request.resource.data.city is string &&
          request.resource.data.city.size() > 0 &&
          request.resource.data.city.size() <= 80 &&
          request.resource.data.state is string &&
          request.resource.data.state.size() > 0 &&
          request.resource.data.state.size() <= 80 &&
          request.resource.data.postalCode is string &&
          request.resource.data.postalCode.matches('^[A-Za-z0-9 -]{3,12}$') &&
          request.resource.data.country is string &&
          request.resource.data.country.size() > 0 &&
          request.resource.data.country.size() <= 60 &&
          request.resource.data.isDefault is bool &&
          request.resource.data.updatedAt == request.time;
      }

      allow get: if isOwner();
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isOwner() && hasValidAddress();
      allow delete: if isOwner();
    }

    match /users/{userId}/wishlist/{productId} {
      function isOwner() {
        return request.auth != null &&
          request.auth.uid == userId &&
          productId.matches('^[0-9]{1,2}$');
      }

      function hasValidWishlistItem() {
        return request.resource.data.keys().hasOnly(["productIndex", "updatedAt"]) &&
          request.resource.data.keys().hasAll(["productIndex", "updatedAt"]) &&
          request.resource.data.productIndex is int &&
          request.resource.data.productIndex >= 0 &&
          request.resource.data.productIndex < 40 &&
          request.resource.data.updatedAt == request.time;
      }

      allow get, list: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isOwner() && hasValidWishlistItem();
      allow delete: if isOwner();
    }
  }
}
